# Exemple de fichier .env pour les variables sensibles
# Copiez ce fichier en .env et remplissez avec vos vraies valeurs

# API SIREN
API_CONSUMER_KEY=your_consumer_key_here
API_CONSUMER_SECRET=your_consumer_secret_here

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_CONTAINER_NAME=siren-data

# Mode d'exécution
EXECUTION_MODE=full
